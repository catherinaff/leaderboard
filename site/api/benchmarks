[{"id":"uci_har","name":"UCI-HAR","category":"Standard","dataset":"UCI Human Activity Recognition Using Smartphones","paper":"Anguita et al., 2013","paper_url":"https://archive.ics.uci.edu/ml/datasets/human+activity+recognition+using+smartphones","modality":"IMU","sensor_type":"Accelerometer + Gyroscope","placement":"Waist-mounted smartphone (Samsung Galaxy S2)","subjects":30,"classes":["Walking","Walking Upstairs","Walking Downstairs","Sitting","Standing","Laying"],"sampling_rate_hz":50,"channels":9,"channel_description":"3 accelerometer (x, y, z) + 3 gyroscope (x, y, z) + 3 total acceleration (x, y, z)","protocol":{"type":"Fixed subject-wise split","train_subjects":"1, 3, 5, 6, 7, 8, 11, 14, 15, 16, 17, 19, 21, 22, 23, 25, 26, 27, 28, 29, 30","test_subjects":"2, 4, 9, 10, 12, 13, 18, 20, 24","train_windows":7352,"test_windows":2947,"window_size_samples":128,"window_size_seconds":2.56,"stride_samples":64,"overlap":"50%","pre_segmented":true,"note":"Official subject membership is read from subject_train.txt and subject_test.txt; preserve the provided 7,352 training and 2,947 test windows.","train_subject_ids":[1,3,5,6,7,8,11,14,15,16,17,19,21,22,23,25,26,27,28,29,30],"test_subject_ids":[2,4,9,10,12,13,18,20,24]},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"UCI-HAR papers and common HAR tables primarily report classification accuracy."},"dataset_url":"https://archive.ics.uci.edu/ml/datasets/human+activity+recognition+using+smartphones","description":"30 subjects performed 6 activities with a waist-mounted smartphone at 50 Hz. The official data contains 128-sample windows with 50% overlap. Use the author-provided subject-level train/test partition (21 training subjects, 9 test subjects); exact subject IDs are listed in the protocol. Subject 14 belongs to the official training partition."},{"id":"wisdm","name":"WISDM","category":"Standard","dataset":"WISDM Activity Prediction (AR v1.1)","paper":"Kwapisz, Weiss & Moore, 2011","paper_url":"https://www.cis.fordham.edu/wisdm/dataset.php","modality":"IMU","sensor_type":"Accelerometer","placement":"Smartphone in pocket (various Android devices)","subjects":36,"classes":["Walking","Jogging","Upstairs","Downstairs","Sitting","Standing"],"sampling_rate_hz":20,"channels":3,"channel_description":"3 accelerometer (x, y, z)","protocol":{"type":"Fixed subject-wise split","train_subjects":"1–30","test_subjects":"31–36","window_size_samples":200,"window_size_seconds":10.0,"stride_samples":100,"overlap":"50%","pre_segmented":false,"note":"Raw time-series data. Methods must implement sliding window segmentation with the specified window size and stride."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"WISDM AR v1.1 evaluations report percent correctly classified; macro-F1 remains secondary because of class imbalance."},"dataset_url":"https://www.cis.fordham.edu/wisdm/dataset.php","description":"36 subjects performed 6 activities (Walking, Jogging, Upstairs, Downstairs, Sitting, Standing) with a smartphone accelerometer in their pocket recording at 20Hz. The data is provided as a continuous raw stream. The task is to segment the stream into 10 second windows with 50% overlap and classify each window into one of the 6 activities. Train on subjects 1 to 30. Test on subjects 31 to 36. Class imbalance is significant. Walking and Jogging have many more samples than stationary activities."},{"id":"usc_had","name":"USC-HAD","category":"Standard","dataset":"USC Human Activity Dataset","paper":"Zhang & Sawchuk, 2012","paper_url":"https://sipi.usc.edu/had/","modality":"IMU","sensor_type":"Accelerometer + Gyroscope","placement":"MotionNode (waist/front-right-hip)","subjects":14,"classes":["Walking Forward","Walking Left","Walking Right","Walking Upstairs","Walking Downstairs","Running Forward","Jumping Up","Sitting","Standing","Sleeping","Elevator Up","Elevator Down"],"sampling_rate_hz":100,"channels":6,"channel_description":"3 accelerometer (x, y, z) + 3 gyroscope (x, y, z)","protocol":{"type":"Leave-One-Subject-Out (LOSO)","folds":14,"train_per_fold":13,"test_per_fold":1,"window_size_samples":200,"window_size_seconds":2.0,"stride_samples":100,"overlap":"50%","pre_segmented":false,"note":"Report mean ± std across all 14 LOSO folds."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"USC-HAD papers and common HAR comparisons primarily report recognition accuracy."},"dataset_url":"https://sipi.usc.edu/had/","description":"14 subjects performed 12 activities (Walking Forward, Walking Left, Walking Right, Walking Upstairs, Walking Downstairs, Running Forward, Jumping Up, Sitting, Standing, Sleeping, Elevator Up, Elevator Down) with a hip-mounted MotionNode sensor recording accelerometer and gyroscope data at 100Hz. The task is to segment the stream into 2 second windows with 50% overlap and classify each window into one of the 12 activities. Use Leave-One-Subject-Out cross validation across all 14 subjects. Report mean and standard deviation of the primary metric across the 14 folds."},{"id":"pamap2","name":"PAMAP2","category":"Standard","dataset":"Physical Activity Monitoring for Aging People 2","paper":"Reiss & Stricker, 2012","paper_url":"https://archive.ics.uci.edu/ml/datasets/pamap2+physical+activity+monitoring","modality":"Multi-IMU","sensor_type":"3 IMUs (accelerometer + gyroscope + magnetometer) + heart rate","placement":"Chest, dominant wrist, dominant ankle","subjects":8,"classes":["Lying","Sitting","Standing","Walking","Running","Cycling","Nordic Walking","Ascending Stairs","Descending Stairs","Vacuum Cleaning","Ironing","Rope Jumping"],"sampling_rate_hz":100,"channels":27,"channel_description":"3 IMU × 9 channels (3 accel + 3 gyro + 3 mag) = 27. Heart rate optional.","protocol":{"type":"Leave-One-Subject-Out (LOSO)","folds":8,"train_per_fold":7,"test_per_fold":1,"window_size_samples":200,"window_size_seconds":2.0,"stride_samples":100,"overlap":"50%","pre_segmented":false,"note":"Report mean ± std across all 8 LOSO folds. All 8 subjects must be evaluated — testing only subject 6 is invalid.","excluded_activities":"6 low-count activities are excluded: watching TV, computer work, car driving, folding laundry, house cleaning, playing soccer (only 1 subject performed these)."},"metrics":{"primary":"accuracy","secondary":["f1_weighted","f1_macro"],"note":"PAMAP2 is commonly compared with recognition/classification accuracy; F1 variants remain secondary."},"dataset_url":"https://archive.ics.uci.edu/ml/datasets/pamap2+physical+activity+monitoring","description":"8 subjects performed 12 activities (Lying, Sitting, Standing, Walking, Running, Cycling, Nordic Walking, Ascending Stairs, Descending Stairs, Vacuum Cleaning, Ironing, Rope Jumping) with three IMUs placed on the chest, dominant wrist, and dominant ankle. Each IMU records 9-axis data at 100Hz. Six activities performed by only one subject are excluded. The task is to segment the stream into 2 second windows with 50% overlap and classify each window into one of the 12 activities. Use Leave-One-Subject-Out cross validation across all 8 subjects. Report mean and standard deviation across the 8 folds. All 8 subjects must be evaluated. Testing only on subject 6 is not valid."},{"id":"skoda","name":"Skoda","category":"Standard","dataset":"Skoda Mini Checkpoint","paper":"Zappi et al., 2008","paper_url":"https://archive.ics.uci.edu/ml/datasets/Skoda+Mini+Checkpoint","modality":"IMU","sensor_type":"Wearable accelerometers","placement":"Right arm","subjects":1,"classes":["10 manipulating gestures","Null"],"sampling_rate_hz":98,"channels":60,"channel_description":"Right-arm wearable accelerometer streams from the Skoda Mini Checkpoint gesture dataset.","protocol":{"type":"Official paper-protocol split","folds":1,"window_size_samples":30,"window_size_seconds":0.31,"stride_samples":15,"overlap":"50%","pre_segmented":false,"note":"Paper-coverage calibration follows the Attend And Discriminate wording for the 10 manipulating gestures. Null-inclusive metrics are retained as secondary caveats when available."},"metrics":{"primary":"f1_macro_no_null","secondary":["f1_macro_all_classes","accuracy_all_classes","f1_weighted_all_classes"],"note":"Primary metric follows the paper-protocol 10 gesture classes; Null-inclusive metrics are secondary caveats."},"dataset_url":"https://archive.ics.uci.edu/ml/datasets/Skoda+Mini+Checkpoint","description":"Skoda Mini Checkpoint records right-arm wearable accelerometer data for assembly-line gestures. For paper-coverage calibration, report macro-F1 on the 10 manipulating gesture classes when the source paper excludes Null from the headline score, and retain Null-inclusive scores as secondary caveats."},{"id":"opportunity_a","name":"OPPORTUNITY — Gesture Recognition","category":"Standard","dataset":"OPPORTUNITY Activity Recognition","paper":"Roggen et al., 2010","paper_url":"https://archive.ics.uci.edu/ml/datasets/opportunity+activity+recognition","modality":"Multimodal","sensor_type":"Body-worn IMUs + object sensors + ambient sensors","placement":"7 IMUs (body) + 12 object sensors (on daily objects) + ambient sensors","subjects":4,"classes":["Open Door 1","Open Door 2","Close Door 1","Close Door 2","Open Fridge","Close Fridge","Open Dishwasher","Close Dishwasher","Open Drawer 1","Open Drawer 2","Open Drawer 3","Close Drawer 1","Close Drawer 2","Close Drawer 3","Clean Table","Drink from Cup","Toggle Switch"],"sampling_rate_hz":30,"channels":113,"channel_description":"113 OPPORTUNITY challenge sensor channels after removing quaternion/orientation and unused columns. Use ADL runs only (not Drill runs).","protocol":{"type":"Leave-One-Subject-Out (LOSO)","folds":4,"train_per_fold":3,"test_per_fold":1,"window_size_samples":30,"window_size_seconds":1.0,"stride_samples":15,"overlap":"50%","pre_segmented":false,"note":"Use ADL run only. Report mean ± std across all 4 LOSO folds."},"metrics":{"primary":"f1_weighted","secondary":["accuracy","f1_macro"],"note":"OPPORTUNITY gesture recognition is commonly evaluated with F1 under strong class imbalance; weighted-F1 is the leaderboard primary."},"dataset_url":"https://archive.ics.uci.edu/ml/datasets/opportunity+activity+recognition","description":"4 subjects performed naturalistic morning activities in a sensor-instrumented room. Sensors include 7 body-worn IMUs and 12 object-mounted sensors (attached to doors, drawers, fridge, dishwasher, and other objects), producing 79 channels at 30Hz. Track A targets 17 fine-grained gesture classes (Open Door 1, Open Door 2, Close Door 1, Close Door 2, Open Fridge, Close Fridge, Open Dishwasher, Close Dishwasher, Open Drawer 1, Open Drawer 2, Open Drawer 3, Close Drawer 1, Close Drawer 2, Close Drawer 3, Clean Table, Drink from Cup, Toggle Switch). The task is to segment the stream into 1 second windows with 50% overlap and classify each window into one of the 17 activities. Use the ADL run only. Use Leave-One-Subject-Out cross validation across all 4 subjects. Report mean and standard deviation across the 4 folds."},{"id":"opportunity_b","name":"OPPORTUNITY — Locomotion","category":"Standard","dataset":"OPPORTUNITY Activity Recognition","paper":"Roggen et al., 2010","paper_url":"https://archive.ics.uci.edu/ml/datasets/opportunity+activity+recognition","modality":"Multimodal","sensor_type":"Body-worn IMUs + object sensors + ambient sensors","placement":"7 IMUs (body) + 12 object sensors (on daily objects) + ambient sensors","subjects":4,"classes":["Stand","Walk","Sit","Lie"],"sampling_rate_hz":30,"channels":113,"channel_description":"113 OPPORTUNITY challenge sensor channels after removing quaternion/orientation and unused columns. Use ADL runs only (not Drill runs). Null/unannotated labels are excluded from canonical evaluation.","protocol":{"type":"Leave-One-Subject-Out (LOSO)","folds":4,"train_per_fold":3,"test_per_fold":1,"window_size_samples":30,"window_size_seconds":1.0,"stride_samples":15,"overlap":"50%","pre_segmented":false,"note":"Use ADL run only. Report mean ± std across all 4 LOSO folds."},"metrics":{"primary":"f1_weighted","secondary":["accuracy","f1_macro"],"note":"OPPORTUNITY locomotion is commonly evaluated with F1 under class imbalance; weighted-F1 is the leaderboard primary."},"dataset_url":"https://archive.ics.uci.edu/ml/datasets/opportunity+activity+recognition","description":"Same sensor setup as Track A. Track B targets 4 evaluated locomotion classes (Stand, Walk, Sit, Lie). Null/unannotated periods are excluded before windowing and evaluation. The task is to segment the stream into 1 second windows with 50% overlap and classify each window into one of the 4 evaluated classes. Use ADL runs only. Use Leave-One-Subject-Out cross validation across all 4 subjects. Report mean and standard deviation across the 4 folds."},{"id":"hhar","name":"HHAR","category":"Standard","dataset":"Heterogeneity Human Activity Recognition (HHAR)","paper":"Stisen et al., SenSys 2015","paper_url":"https://doi.org/10.1145/2809695.2809718","dataset_url":"https://archive.ics.uci.edu/ml/datasets/Heterogeneity+Activity+Recognition","modality":"IMU","sensor_type":"Accelerometer + Gyroscope (multiple smartphone and smartwatch models)","placement":"Waist (smartphone) — standard track. Other positions available for cross-device evaluation.","subjects":9,"classes":["Biking","Sitting","Standing","Walking","Upstairs","Downstairs"],"sampling_rate_hz":"varies by device (50–200Hz)","channels":6,"channel_description":"3 accelerometer (x, y, z) + 3 gyroscope (x, y, z). Varies by device model.","protocol":{"type":"Leave-One-Subject-Out (LOSO)","folds":9,"train_per_fold":8,"test_per_fold":1,"window_size_samples":100,"window_size_seconds":2.0,"stride_samples":50,"overlap":"50%","sampling_rate_hz":50,"pre_segmented":false,"device":"Use smartphone (waist/pocket) data only for the standard track. Multi-device evaluation is a separate cross-device track.","note":"Resample all device data to 50 Hz before windowing. Report mean ± std across all 9 LOSO folds."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"HHAR and device-heterogeneity HAR papers commonly report recognition accuracy; macro-F1 remains secondary."},"description":"9 subjects performed 6 activities (Biking, Sitting, Standing, Walking, Upstairs, Downstairs) using multiple smartphone and smartwatch models recording accelerometer and gyroscope data at varying rates (50–200Hz). The task is to resample all recordings to 50Hz, segment into 2 second windows with 50% overlap, and classify each window into one of the 6 activities. Use Leave-One-Subject-Out cross validation across all 9 subjects. Report mean and standard deviation across the 9 folds. Only smartphone (waist/pocket) data is used for the standard track. HHAR is distinct from UCI-HAR in that it captures device heterogeneity — different phone models produce different signal characteristics for the same activity."},{"id":"realworld_har","name":"RealWorld-HAR","category":"Standard","dataset":"RealWorld HAR Dataset 2016","paper":"Sztyler & Stuckenschmidt, 2016","paper_url":"https://www.uni-mannheim.de/dws/research/projects/activity-recognition/dataset/dataset-realworld/","dataset_url":"https://www.uni-mannheim.de/dws/research/projects/activity-recognition/dataset/dataset-realworld/","official_csv_base_url":"https://www.uni-mannheim.de/media/Einrichtungen/dws/Files_Research/Projects/sensor/realworld","full_archive_url":"http://wifo5-14.informatik.uni-mannheim.de/sensor/dataset/realworld2016/realworld2016_dataset.zip","modality":"IMU","sensor_type":"Accelerometer + Gyroscope from multiple wearable positions","placement":"Seven on-body positions: chest, forearm, head, shin, thigh, upper arm, waist","subjects":15,"classes":["Climbing Down","Climbing Up","Jumping","Lying","Running","Sitting","Standing","Walking"],"sampling_rate_hz":50,"channels":42,"channel_description":"Seven body positions, each with 3-axis accelerometer 