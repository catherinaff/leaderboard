ts","subjects":10,"classes":["Standing still","Sitting and relaxing","Lying down","Walking","Climbing stairs","Waist bends","Frontal arm elevation","Knees bending","Cycling","Jogging","Running","Jump front and back"],"sampling_rate_hz":50,"channels":23,"channel_description":"Body-worn inertial sensors plus ECG channels","protocol":{"type":"Canonical runner pending","window_size_samples":100,"window_size_seconds":2.0,"stride_samples":50,"overlap":"50%","pre_segmented":false,"note":"Added as a commonly used HAR benchmark; exact canonical split will be pinned before official reruns."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"Most MHEALTH HAR reports use accuracy; F1 is kept for imbalanced or LOSO evaluations."},"dataset_url":"https://archive.ics.uci.edu/dataset/319/mhealth+dataset","description":"Wearable multi-sensor HAR dataset with 10 subjects and 12 activities using chest, wrist, and ankle sensors."},{"id":"dsads","name":"DSADS","category":"Standard","dataset":"Daily and Sports Activities Dataset","paper":"Altun, Barshan & Tuncel, 2010","paper_url":"https://archive.ics.uci.edu/dataset/256/daily+and+sports+activities","modality":"IMU","sensor_type":"Accelerometer + Gyroscope + Magnetometer","placement":"Torso, right arm, left arm, right leg, and left leg","subjects":8,"classes":["Sitting","Standing","Lying","Walking","Running","Cycling","Nordic walking","Ascending stairs","Descending stairs","Vacuum cleaning","Ironing","Rope jumping","Playing basketball","Exercise activities"],"sampling_rate_hz":25,"channels":45,"channel_description":"Five Xsens MTx units, each with 9 inertial/magnetic channels","protocol":{"type":"Canonical runner pending","window_size_samples":125,"window_size_seconds":5.0,"stride_samples":62,"overlap":"50%","pre_segmented":false,"note":"Added as a common multi-sensor controlled HAR benchmark; exact activity subset/split must be pinned before official reruns."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"Accuracy is the most common DSADS summary metric; F1 remains secondary."},"dataset_url":"https://archive.ics.uci.edu/dataset/256/daily+and+sports+activities","description":"Controlled daily and sports activity dataset collected from 8 subjects wearing five body-worn sensor units."},{"id":"unimib_shar","name":"UniMiB-SHAR","category":"Standard","dataset":"UniMiB-SHAR","paper":"Micucci, Mobilio & Napoletano, 2017","paper_url":"https://www.mdpi.com/1424-8220/17/10/2206","modality":"IMU","sensor_type":"Accelerometer","placement":"Smartphone in trouser pocket","subjects":30,"classes":["Standing up from sitting","Standing up from lying","Walking","Running","Going upstairs","Jumping","Going downstairs","Lying down from standing","Sitting down","Falling activities"],"sampling_rate_hz":50,"channels":3,"channel_description":"3-axis smartphone acceleration windows","protocol":{"type":"Canonical runner pending","window_size_samples":151,"window_size_seconds":3.02,"stride_samples":null,"overlap":"Dataset windows around detected peaks","pre_segmented":true,"note":"Added for smartphone ADL/fall coverage; exact split and fall/ADL subset will be pinned before official reruns."},"metrics":{"primary":"accuracy","secondary":["f1_macro","f1_weighted"],"note":"UniMiB-SHAR papers commonly report accuracy; F1 is useful for fall/ADL imbalance."},"dataset_url":"https://www.mdpi.com/1424-8220/17/10/2206","description":"Smartphone acceleration dataset covering activities of daily living and falls from 30 subjects."},{"id":"mobiact","name":"MobiAct","category":"Standard","dataset":"MobiAct","paper":"Vavoulas et al., 2016","paper_url":"https://bmi.hmu.gr/the-mobifall-and-mobiact-datasets-2/","modality":"IMU","sensor_type":"Accelerometer + Gyroscope + Orientation","placement":"Smartphone in trouser pocket","subjects":57,"classes":["Standing","Walking","Jogging","Jumping","Stairs up","Stairs down","Sitting","Chair activities","Car activities","Falls"],"sampling_rate_h